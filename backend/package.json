{
  "name": "@cloud-reporting/backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch app.ts",
    "worker": "tsx watch worker.ts",
    "build": "tsc -p tsconfig.json && node scripts/copy-assets.mjs",
    "test": "tsx --test test/*.test.ts",
    "start": "node dist/app.js",
    "start:worker": "node dist/worker.js",
    "db:migrate": "tsx shared/db/migrations.ts",
    "db:seed": "tsx shared/db/seed.ts"
  },
  "dependencies": {
    "@google-cloud/storage": "^9.0.0",
    "@supabase/supabase-js": "^2.119.1",
    "bcryptjs": "^3.0.2",
    "cors": "^2.8.5",
    "dotenv": "^17.2.3",
    "drizzle-orm": "^0.45.4",
    "express": "^5.1.0",
    "express-rate-limit": "^8.2.1",
    "google-auth-library": "^11.3.4",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.2",
    "pdf-lib": "^1.17.1",
    "pg": "^8.16.3",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.5",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^24.10.0",
    "@types/pg": "^8.15.6",
    "tsx": "^4.20.6",
    "typescript": "^7.0.2"
  }
}
